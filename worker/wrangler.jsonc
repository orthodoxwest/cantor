{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cantor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The built app. `/api/*` always reaches the Worker; everything else is served from here.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cantor",
      "database_id": "9fc51a09-6360-41bf-a46b-78e2763c5a43",
      "migrations_dir": "migrations"
    }
  ],
  // Production value; .dev.vars and the test config override it with "dev".
  "vars": { "ENV": "prod" },
  // Takes will live in R2 once it is enabled on the account:
  // "r2_buckets": [{ "binding": "TAKES", "bucket_name": "cantor-takes" }]
  "workers_dev": true
}
