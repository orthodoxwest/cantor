{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cantor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The built app. `/api/*`, sign-in and a take's page always reach the Worker; everything else
  // is served from here.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/signin", "/take/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cantor",
      "database_id": "9fc51a09-6360-41bf-a46b-78e2763c5a43",
      "migrations_dir": "migrations"
    }
  ],
  // Production value; .dev.vars and the test config override it with "dev". Outside dev, only a
  // Cloudflare Access token for this team and application names a caller (neither value is
  // secret); while either is empty, nobody is signed in.
  "vars": {
    "ENV": "prod",
    "ACCESS_TEAM": "https://odd-sound-2cc5.cloudflareaccess.com",
    "ACCESS_AUD": "8d88c4c5e22059269fe76a28f29ce5811131e23095dc2b9a9e599b50187f0c75"
  },
  // Student takes, the private chants' aligned recordings as sound, and the chants rendered in a
  // voice made from a cantor's; the bucket exists on the account.
  "r2_buckets": [{ "binding": "TAKES", "bucket_name": "cantor-takes" }],
  "workers_dev": true
}
